# Server
PORT=5000
NODE_ENV=development

# Allowed browser origin(s) for CORS, comma separated
CLIENT_ORIGIN=http://localhost:5173

# Auth - use a long random string outside development
JWT_SECRET=change-me-to-a-long-random-string

# Database
# Leave DATABASE_URL empty to use the embedded PostgreSQL (PGlite) stored in PGLITE_DIR.
# Set it to use a real PostgreSQL server, e.g.
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/eventflow
DATABASE_URL=
PGLITE_DIR=.data/pglite
