# Server
PORT=5000
NODE_ENV=development

# Allowed browser origin(s) for CORS, comma separated
CLIENT_ORIGIN=http://localhost:5173

# Auth - use a long random string outside development (required when NODE_ENV=production)
JWT_SECRET=change-me-to-a-long-random-string

# Public address of the web app. Certificate QR codes link to <PUBLIC_APP_URL>/verify/<id>
PUBLIC_APP_URL=http://localhost:5173

# AI recommendation ideas (Phase 10).
# Leave ANTHROPIC_API_KEY empty to switch the AI features off; everything else keeps working.
# The key is used only on the server and is never sent to the browser.
ANTHROPIC_API_KEY=
# AI_MODEL=claude-opus-5-5
# AI_EFFORT=medium

# Database
# Leave DATABASE_URL empty to use the embedded PostgreSQL (PGlite) stored in PGLITE_DIR.
# Set it to use a real PostgreSQL server, e.g.
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/eventflow
DATABASE_URL=
PGLITE_DIR=.data/pglite

# Help Center
# New help requests per person in ten minutes, and how many may be open at once per event.
# HELP_CREATE_LIMIT=8
# HELP_MAX_OPEN=5
# Where help photos are stored. Keep it OUTSIDE the public uploads folder.
# HELP_UPLOAD_DIR=private/help

# Email (Resend, https://resend.com). The key is used only on the server and is never sent to the browser.
# Leave EMAIL_PROVIDER_API_KEY empty to send nothing: sign-up still works (no verification is asked for),
# "Resend Verification Email" answers "We couldn't send the email right now" and admins see a warning on their dashboard.
# EMAIL_FROM must be an address on a domain you have verified with Resend.
EMAIL_PROVIDER_API_KEY=
# EMAIL_FROM is the one "from" address every email comes from; it is not an account anyone logs in to.
# With Resend's free test sender (EventFlow <onboarding@resend.dev>) mail is only delivered to the
# address you opened your Resend account with. Verify your own domain to email everyone.
EMAIL_FROM=EventFlow <no-reply@yourcollege.edu>
# Address of the web app. Every link in an email (verify your email, event pass) starts with this.
# Set it to where the frontend really runs. Falls back to PUBLIC_APP_URL, then CLIENT_ORIGIN.
APP_URL=http://localhost:5173
# Optional. New accounts must verify their email before they can log in. That is on whenever email is
# configured and always in production; set false to switch it off, or true to also force it on a
# development machine that has no email set up.
# EMAIL_VERIFICATION_REQUIRED=
# Optional. Pause between messages in the background queue, in milliseconds (default 600, under Resend's 2 per second).
# EMAIL_SEND_INTERVAL_MS=600
# Rate limits. Each one counts requests in a window of time; the values below are the defaults.
# They protect sign-in and email sending from abuse without getting in the way of normal use.
#
# Everything else the app does, per signed-in account (browsing events, schedules, the dashboard...).
# Generous on purpose: the busiest page, a live control center, makes about 20 requests a minute.
# USER_RATE_LIMIT_MAX=1500
# People who are not signed in, per IP address.
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX=100
# Login. Only FAILED attempts count, so logging in correctly is never blocked. Per IP address and email,
# and across all emails from one IP address.
# AUTH_RATE_LIMIT_WINDOW_MS=900000
# AUTH_RATE_LIMIT_MAX=10
# AUTH_RATE_LIMIT_IP_MAX=50
# Sign-up attempts per IP address (attempts that only fail validation do not count).
# Raise this if many students sign up from one college network at the same time.
# SIGNUP_RATE_LIMIT_WINDOW_MS=3600000
# SIGNUP_RATE_LIMIT_MAX=5
# The emails people can ask for (verification resend, change of address):
# per email address, per IP address, and the pause between two emails to the same address.
# EMAIL_RATE_LIMIT_WINDOW_MS=3600000
# EMAIL_RATE_LIMIT_MAX=3
# EMAIL_RATE_LIMIT_IP_MAX=20
# EMAIL_RESEND_COOLDOWN_SECONDS=60
# Opening the emailed verification link, per IP address.
# LINK_RATE_LIMIT_MAX=200
# On localhost in development every limit is this many times higher so working on the app is never
# blocked. It has no effect in production. Set it to 1 to try the real numbers.
# RATE_LIMIT_DEV_MULTIPLIER=10
# One line in the server log for each blocked client (never with passwords, keys or tokens). false = off.
# RATE_LIMIT_LOG=true
# Behind a reverse proxy (nginx, a load balancer, a hosting platform) set how many proxies there are,
# for example 1. Without it every visitor looks like the proxy and they all share one limit.
# TRUST_PROXY=1
